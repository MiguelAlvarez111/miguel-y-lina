---
interface Props { direction?: 'up-right' | 'down' | 'up' | 'left' | 'right' }
const {direction='up-right'}=Astro.props;
const rotation={'up-right':0,down:135,up:-45,left:225,right:45}[direction];
---
<svg class="arrow-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><g transform={`rotate(${rotation} 12 12)`}><path d="M6 18 18 6M6 6h12v12"/></g></svg>
