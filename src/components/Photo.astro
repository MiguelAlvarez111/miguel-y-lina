---
import type {Photo} from '../config/wedding';
interface Props {photo:Photo;class?:string;hero?:boolean;sizes?:string;}
const {photo,class:className,hero=false,sizes='(max-width: 700px) 90vw, 45vw'}=Astro.props;
---
<img class={className} src={`/photos/${photo.id}-960.webp`} srcset={`/photos/${photo.id}-480.webp 480w, /photos/${photo.id}-960.webp 960w, /photos/${photo.id}-1600.webp 1600w`} sizes={sizes} width="1350" height="1800" alt={photo.alt} loading={hero?'eager':'lazy'} fetchpriority={hero?'high':'auto'} decoding="async" style={`object-position:${photo.position || '50% 50%'}`} />
